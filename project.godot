; Engine configuration file.
; Lethemoor: The Last Lantern. Godot 4.5, GDScript only, phone-first (portrait).

config_version=5

[application]

config/name="Lethemoor: The Last Lantern"
config/description="Gothic tactics-horror roguelite. Light is life."
run/main_scene="res://scenes/fp_room.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]

; all sound: scripts/audio.gd (clips in assets/audio/, sources in assets/audio/SOURCES.md)
Audio="*res://scripts/audio.gd"

[display]

; UI base 540x960 portrait (pivot doc). canvas_items: the 3D renders at the phone's full
; resolution (HD-2D needs that), the UI scales up from 540x960. "expand" fills tall phones.
window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

; Compatibility everywhere: it's the only renderer that runs on iPhone Safari (web build)
; and it keeps Android and web looking the same.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.02, 0.03, 0.05, 1)
