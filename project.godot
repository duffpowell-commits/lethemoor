; Engine configuration file.
; Lethemoor: The Last Lantern. Godot 4.5, GDScript only, phone-first (portrait).

config_version=5

[application]

config/name="Lethemoor: The Last Lantern"
config/description="Gothic tactics-horror roguelite. Light is life."
run/main_scene="res://scenes/room.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]

; Pixel-art base resolution: 360x640 portrait (11 x 20 tiles of 32 px).
; Scaled up by whole numbers so pixels stay crisp on phones.
window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=720
window/size/window_height_override=1280
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"
window/handheld/orientation=1

[rendering]

; Compatibility everywhere: it's the only renderer that runs on iPhone Safari (web build)
; and it keeps Android and web looking the same.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.02, 0.03, 0.05, 1)
